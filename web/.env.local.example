# Required: Supabase project connection used by the web app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side scripts that administer Supabase storage.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: image generation. Configure either key name.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Optional: remote media storage. The default provider is local.
MEDIA_STORAGE_PROVIDER=local
# MEDIA_STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# AWS_S3_PREFIX=baby-keyboard
# MEDIA_STORAGE_BASE_URL=https://media.example.com

# Optional: local development auth redirect.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000
